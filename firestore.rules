rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Responses Collection:
    // 1. Visitors can ONLY create responses (write-only), preventing anyone from reading other people's submissions.
    // 2. Only authenticated Deb (admin) can read, update, or delete responses.
    match /responses/{responseId} {
      allow create: if request.resource.data.keys().hasAll(['smileResponse', 'feelingResponse', 'timestamp']);
      allow read, update, delete: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
